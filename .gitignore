# Octopus Pet — gitignore
# 四分类: 组件面/开发面 提交; 中间产物/本地噪音 忽略。
# 可分发产物 (bin/octopus-pet.${KERNEL}.bin, spritesheet webp, manifest) 提交 — repo 即插件。
# 注意: gitignore 不支持行内注释, 所有 # 必须单独成行。

# ── 中间产物 (可重建, 不提交) ──────────────────────────────
src-tauri/target/
src-tauri/gen/
src-tauri/.tauri/
src-tauri/WixTools/
app/dist/
app/node_modules/
app/.vite/
app/tsconfig.tsbuildinfo
dist/
app/public/assets/octopus/spritesheet-*.miff

# H3 源视频 (mp4) — 中间产物, APNG 才是 deployed
docs/h3-source-*/
docs/*.mp4

# ── 本地构建/审计缓存 ─────────────────────────────────────
.local-audit/
.local-frames/
OCTOPUS_DATA/

# ── Editor / OS ────────────────────────────────────────────
# macOS Finder 自动生成, ** 显式递归匹配所有层级 (不带路径前缀的 .DS_Store
# 默认也匹配所有层级, 加 ** 是 explicit 防误改).
**/.DS_Store
.DS_Store
.idea/
.vscode/
*.swp
*.swo
*~

# ── Logs ───────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Local config / secrets ─────────────────────────────────
.env
.env.local
*.local
secrets/
secrets.json

# ── 历史 venv / model weights (可删) ──────────────────────
# v5.x 期间 BiRefNet + CorridorKey 用的 Python venv + model weights, v10-final
# 改 PIL + 6 阶段 pipeline 后已不依赖, 历史噪音. 删了重建:
#   `python3 -m venv .venv-birefnet` (venv, 1GB)
#   `huggingface-cli download ZhengPeng7/BiRefNet` (model weights, 444MB)
.venv-birefnet/
.venv*/
models/

# ── Backup / temp ──────────────────────────────────────────
*.bak
*.tmp
.cache/

# ── 无关文档 (不属于 octopus-pet) ─────────────────────────
codebuddy-integration-gap-report.md

# ── 素材探索过程 (本地参考, 不入 git) ────────────────────
# V1 探索期: 立绘/视频/抠图帧/对比图等中间产物 (~300MB).
# V2 重做素材链 (绿幕 + 标图), 这些都作废.
art/

# 注: src-tauri/Cargo.lock 必须提交 (应用项目可复现构建, CI cache key 依赖它)

# Local test artifacts (do not commit)
*.webm
!app/public/assets/**/*.webm

docs/v2-*/preview.gif
.omo/

# Python
__pycache__/
*.pyc
*.pyo

# Deprecated matting pipeline outputs (replaced by current default)
*.v*-deprecated
